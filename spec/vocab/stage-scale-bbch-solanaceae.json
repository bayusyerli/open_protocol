{
  "$schema": "../schema/stage-scale.schema.json",
  "id": "op:sca:00000001",
  "key": "bbch-solanaceae",
  "label": {
    "id": "BBCH — Solanaceae (cabai, tomat, terung)",
    "en": "BBCH scale — solanaceous fruit"
  },
  "definition": {
    "id": "Skala fenologi BBCH untuk sayuran buah famili Solanaceae. Memuat 37 kode yang ditabelkan di sumber, ditambah kode antara pada deret ke-n (daun, tunas samping, perbungaan, dompolan buah) yang mengikuti pola baku BBCH dan ditandai di field mappings.note masing-masing. Fase utama 3 dan 4 memang tidak dipakai pada kelompok ini."
  },
  "basis": "phenology",
  "applies_to": {
    "commodity_kinds": [
      "crop"
    ],
    "commodities": []
  },
