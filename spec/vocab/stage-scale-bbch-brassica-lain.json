{
  "$schema": "../schema/stage-scale.schema.json",
  "id": "op:sca:00000012",
  "key": "bbch-brassica-lain",
  "label": {
    "id": "BBCH — Brassica lain (kembang kol, brokoli, kubis brussel)",
    "en": "BBCH scale — other brassica vegetables"
  },
  "definition": {
    "id": "Skala fenologi BBCH untuk brassica yang dipanen bunga atau kuncupnya: kubis brussel (Brassica oleracea var. gemmifera), kembang kol (var. botrytis), dan brokoli (var. italica). Fase utama 4 punya dua bacaan berdampingan — perkembangan kuncup samping untuk kubis brussel, pembentukan massa bunga untuk kembang kol dan brokoli — dan keduanya disalin ke dalam satu label."
  },
  "basis": "phenology",
  "applies_to": {
    "commodity_kinds": [
      "crop"
    ],
    "commodities": [
      {
        "id": "op:cmd:00001221",
        "label": "Kubis Bunga"
      },
      {
        "id": "op:cmd:00001248",
        "label": "Brokoli"
      }
    ]
  },
  "mappings": [
    {
      "scheme": "BBCH",
      "id": "bbch-other-brassica",
      "relation": "exact",
      "note": "Kunci BBCH brassica lain, dirujuk monograf ke Feller dkk. (1995 a)."
    }
  ],
  "notes": {
    "id": "Fase utama 2 hanya berlaku untuk brokoli, fase utama 3 hanya untuk kubis brussel, dan fase 41–49 serta 51 punya bacaan berbeda menurut jenisnya. Kode 42 dan 44 tidak ada di sumber. Panen konsumsi terjadi pada fase 49; fase 5 sampai 8 hanya terjadi pada tanaman yang dibiarkan berbunga untuk produksi benih."
  },
